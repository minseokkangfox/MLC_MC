    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 56 ],
    "layer": 50,
    "visible": false,
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = '§m§l§c')",
        "target_property_name": "#visible"
      }
    ]
  }
